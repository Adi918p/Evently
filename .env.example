# Copy to .env locally. Never commit real values. Test and live Razorpay keys must not be mixed.
MONGO_URI=mongodb://127.0.0.1:27017/evently?replicaSet=rs0
# Optional, only when local DNS fails to resolve MongoDB Atlas SRV/TXT records.
# EVENTLY_DNS_SERVERS=1.1.1.1,8.8.8.8
JWT_SECRET=replace-with-a-long-random-secret
FRONTEND_URL=http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
MAIL_TRANSPORT=brevo
BREVO_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=Evently
# Set to one inbox you authorize for integration tests.
EMAIL_TEST_TO=
# Legacy Gmail is used only when MAIL_TRANSPORT=smtp is explicitly selected.
EMAIL_USER=
EMAIL_PASS=
# Set only after verifying the actual trusted proxy topology. Never use true.
# TRUST_PROXY=1

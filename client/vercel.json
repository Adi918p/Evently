{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://api.event-ly.in/api/:path*"
    },
    {
      "source": "/Media/:path*",
      "destination": "https://api.event-ly.in/Media/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://api.event-ly.in/uploads/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

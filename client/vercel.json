{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/assets/:path*",
      "destination": "/api/static-not-found"
    },
    {
      "source": "/api/:path*",
      "destination": "https://api.event-ly.in/api/:path*"
    },
    {
      "source": "/Media/:path*",
      "destination": "https://api.event-ly.in/Media/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://api.event-ly.in/uploads/:path*"
    },
    {
      "source": "/sitemap.xml",
      "destination": "https://api.event-ly.in/sitemap.xml"
    },
    {
      "source": "/:path((?!.*\\.(?![hH][tT][mM][lL]$)[^/]+$).*)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|Twitterbot|WhatsApp|LinkedInBot|Slackbot|Slack-ImgProxy|Discordbot|TelegramBot|Pinterest|redditbot|Googlebot|Google-InspectionTool|AdsBot-Google|Storebot-Google|bingbot|BingPreview|DuckDuckBot|YandexBot|Applebot|SkypeUriPreview|vkShare|embedly|Iframely|Mastodon|Bluesky|Yeti|Baiduspider).*"
        }
      ],
      "destination": "https://api.event-ly.in/seo/render/:path*"
    },
    {
      "source": "/((?!.*\\.(?![hH][tT][mM][lL]$)[^/]+$).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ]
}
